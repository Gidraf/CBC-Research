# ─────────────────────────────────────────────────────────────────────────────
# ENVIRONMENT VARIABLES — CBC Research & Google Drive Extractor
# ─────────────────────────────────────────────────────────────────────────────

# Python Configuration
PYTHONUNBUFFERED=1

# PostgreSQL Database Connection
# Inside Docker: postgresql://postgres:postgres@postgres:5432/cbc_research
# Host VM:       postgresql://postgres:postgres@localhost:5432/cbc_research
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/cbc_research

# PostgreSQL Credentials (used by Docker Compose db service)
POSTGRES_DB=cbc_research
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis Cache & Celery Broker Connection
# Inside Docker: redis://redis:6379/0
# Host VM:       redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# MinIO S3 Object Storage Settings
# Inside Docker: minio:9000
# Host VM:       localhost:9000
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cbc-research-files
MINIO_USE_SSL=false
