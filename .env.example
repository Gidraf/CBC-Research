# ─────────────────────────────────────────────────────────────────────────────
# ENVIRONMENT VARIABLES — CBC Research & Google Drive Extractor
# ─────────────────────────────────────────────────────────────────────────────

# App & Python Configuration
PYTHONUNBUFFERED=1
PORT=5550

# PostgreSQL Database Configuration
# Inside Docker Network: postgresql://postgres:postgres@postgres:5432/cbc_research
# Direct Host VM:        postgresql://postgres:postgres@localhost:5432/cbc_research
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/cbc_research
POSTGRES_DB=cbc_research
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis Cache & Celery Task Broker
# Inside Docker Network: redis://redis:6379/0
# Direct Host VM:        redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# MinIO S3 Object Storage Configuration
# Inside Docker Network: minio:9000
# Direct Host VM:        localhost:9000
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cbc-research-files
MINIO_USE_SSL=false

# Optional Langfuse Dataset & LLM Observability
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
